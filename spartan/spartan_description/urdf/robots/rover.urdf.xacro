<?xml version="1.0"?>

<robot name="spartan" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="robot_name" default="spartan"/>
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="use_gazebo" default="false"/>

  <xacro:property name="base_length" value="0.420"/>
  <xacro:property name="base_width"  value="0.120"/>
  <xacro:property name="base_height" value="0.120"/>
  <xacro:property name="base_mass"   value="5.0"/>

  <xacro:property name="wheel_radius" value="0.085"/>
  <xacro:property name="wheel_width"  value="0.140"/>

  <xacro:property name="wheel_mass"   value="0.20"/>

  <xacro:property name="caster_radius" value="0.015"/>
  <xacro:property name="caster_mass"   value="0.05"/>

  <xacro:include filename="$(find spartan_description)/urdf/mech/wheel.urdf.xacro"/>
  <xacro:include filename="$(find spartan_description)/urdf/mech/base.urdf.xacro"/>

  <xacro:include filename="$(find spartan_description)/urdf/sensors/gps.urdf.xacro"/>

  <xacro:base
    prefix="$(arg prefix)"
    base_name="base"
    parent="base_footprint"
    xyz_offset="0 0 0"
    rpy_offset="0 0 0"
    base_length="${base_length}"
    base_width="${base_width}"
    base_height="${base_height}"
    base_mass="${base_mass}"/>
  <!-- Front-left wheel -->

  <xacro:wheel
    prefix="$(arg prefix)"
    wheel_name="front_left_wheel"
    parent="base_link"
    xyz_offset="0.170 0.1575 0.020"
    rpy_offset="0 0 0"
    axis="0 1 0"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    wheel_mass="${wheel_mass}"/>
  <!-- Rear-right wheel -->

  <xacro:wheel
    prefix="$(arg prefix)"
    wheel_name="rear_right_wheel"
    parent="base_link"
    xyz_offset="-0.170 -0.1575 0.020"
    rpy_offset="0 0 0"
    axis="0 1 0"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    wheel_mass="${wheel_mass}"/>
  <!-- Rear-left wheel -->

  <xacro:wheel
    prefix="$(arg prefix)"
    wheel_name="rear_left_wheel"
    parent="base_link"
    xyz_offset="0.170 -0.1575 0.020"
    rpy_offset="0 0 0"
    axis="0 1 0"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    wheel_mass="${wheel_mass}"/>
  <!-- Front-right wheel -->

  <xacro:wheel
    prefix="$(arg prefix)"
    wheel_name="front_right_wheel"
    parent="base_link"
    xyz_offset="-0.170 0.1575 0.020"
    rpy_offset="0 0 0"
    axis="0 1 0"
    wheel_radius="${wheel_radius}"
    wheel_width="${wheel_width}"
    wheel_mass="${wheel_mass}"/>

  <xacro:gps
    prefix="$(arg prefix)"
    gps_name="gps"
    parent="base_link"
    xyz_offset="0 0 0.055"
    rpy_offset="0 0 0"/>
</robot>